{
  "name": "@contract-kit/vue",
  "version": "0.1.0",
  "description": "Vue 3 helpers for contract-kit",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "dependencies": {
    "@contract-kit/kernel": "0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "vue": "^3.5.13"
  }
}
